{
    "routes": [
        {
            "route": "/api/manage/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/orgs/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/platform/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/invitations/accept",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/.auth/login/github",
            "statusCode": 404
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/.auth/*", "/tools/*", "/static/*", "/*.{ico,png,json,txt,js,css}"]
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
    },
    "platform": {
        "apiRuntime": "node:20"
    }
}
