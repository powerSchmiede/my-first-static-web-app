{
    "routes": [
        {
            "route": "/api/manage/*",
            "allowedRoles": ["admin"]
        },
        {
            "route": "/.auth/login/github",
            "statusCode": 404
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/.auth/*", "/tools/*", "/static/*", "/*.{ico,png,json,txt,js,css}"]
    },
    "platform": {
        "apiRuntime": "node:20"
    }
}
