{
    "routes": [
        {
            "route": "/api/apps",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/apps/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/manage/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/orgs/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/platform/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/invitations/accept",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/.auth/login/github",
            "statusCode": 404
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/.auth/*","/static/*", "/*.{ico,png,json,txt,js,css}"]
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
    },
    "platform": {
        "apiRuntime": "node:20"
    },
    "auth": {
        "identityProviders": {
            "azureActiveDirectory": {
                "userDetailsClaim": "preferred_username",
                "registration": {
                    "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
                    "clientIdSettingName": "M365_CLIENT_ID",
                    "clientSecretSettingName": "M365_CLIENT_SECRET"
                }
            },
            "customOpenIdConnectProviders": {
                "kanzleimind": {
                    "registration": {
                        "clientIdSettingName": "AAD_CLIENT_ID",
                        "clientCredential": {
                            "clientSecretSettingName": "AAD_CLIENT_SECRET"
                        },
                        "openIdConnectConfiguration": {
                            "wellKnownOpenIdConfiguration": "https://kanzleimind.ciamlogin.com/55d6bdad-d303-4e5a-bbe1-fb96d7664394/v2.0/.well-known/openid-configuration"
                        }
                    },
                    "login": {
                        "nameClaimType": "email",
                        "scopes": ["openid", "profile", "email"]
                    }
                },
                "kanzleimindsignup": {
                    "registration": {
                        "clientIdSettingName": "AAD_CLIENT_ID",
                        "clientCredential": {
                            "clientSecretSettingName": "AAD_CLIENT_SECRET"
                        },
                        "openIdConnectConfiguration": {
                            "wellKnownOpenIdConfiguration": "https://kanzleimind.ciamlogin.com/55d6bdad-d303-4e5a-bbe1-fb96d7664394/v2.0/.well-known/openid-configuration"
                        }
                    },
                    "login": {
                        "nameClaimType": "email",
                        "scopes": ["openid", "profile", "email"],
                        "loginParameterNames": ["prompt=create"]
                    }
                }
            }
        }
    }
}
