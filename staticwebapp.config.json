{
    "routes": [
        {
            "route": "/api/apps",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/apps/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/manage/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/orgs/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/platform/*",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/api/invitations/accept",
            "allowedRoles": ["authenticated"]
        },
        {
            "route": "/.auth/login/github",
            "statusCode": 404
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*", "/.auth/*","/static/*", "/*.{ico,png,json,txt,js,css}"]
    },
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
    },
    "platform": {
        "apiRuntime": "node:20"
    },
    "auth": {
        "identityProviders": {
            "azureActiveDirectory": {
                "registration": {
                    "openIdIssuer": "https://kanzleimind.ciamlogin.com/55d6bdad-d303-4e5a-bbe1-fb96d7664394/v2.0",
                    "clientIdSettingName": "AAD_CLIENT_ID",
                    "clientSecretSettingName": "AAD_CLIENT_SECRET"
                },
                "login": {
                    "loginParameters": ["scope=openid profile email"]
                }
            }
        }
    }
}
